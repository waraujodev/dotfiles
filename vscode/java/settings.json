{
  // ===========================
  // Comum (copiado do perfil Padrão)
  // ===========================
  // Habilita os breadcrumbs no editor do documento (exibe o caminho completo e permite interações)
  "breadcrumbs.enabled": false,
  // ---------------------------
  // Explorer
  // ---------------------------
  // Mantém as pastas do File Explorer compactadas
  "explorer.compactFolders": false,
  "explorer.confirmDelete": true,
  // ---------------------------
  // Window
  // ---------------------------
  "window.commandCenter": false,
  "workbench.tree.indent": 20,
  // ---------------------------
  // Workbench
  // ---------------------------
  "workbench.iconTheme": "symbols",
  "workbench.colorTheme": "Min Dark",
  // Aqui eu também posso utilizar a configuração de sempre abrir um novo arquivo em branco [Para exibir, é só abrir outro editor]
  "workbench.startupEditor": "newUntitledFile",
  // Preserva apenas os últimos 20 comandos executados na 'paleta de comandos', mas mantém o último valor digitado
  "workbench.commandPalette.history": 20,
  "workbench.commandPalette.preserveInput": true,
  // Estiliza o tamanho/formato da tab de um arquivo pinado
  "workbench.editor.pinnedTabSizing": "compact",
  "workbench.editor.enablePreview": false,
  // ---------------------------
  // Editor
  // ---------------------------
  "editor.fontFamily": "JetBrains Mono",
  "editor.fontSize": 13,
  "editor.lineHeight": 1.6,
  "editor.letterSpacing": 0.4,
  // Desabilita a exibição do minimap do código na lateral direita
  "editor.minimap.enabled": false,
  // Boas práticas
  "editor.rulers": [
    80,
    120
  ],
  // Detalhes
  "editor.cursorBlinking": "expand",
  "diffEditor.ignoreTrimWhitespace": false,
  // ---------------------------
  // Terminal
  // ---------------------------
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  // Controles básicos da busca do VSCode: sempre mostra minimizado e não busca em diretórios "auto-gerados" para otimizar a execução.
  "search.collapseResults": "alwaysCollapse",
  // ---------------------------
  // Economia de recursos
  // ---------------------------
  "telemetry.telemetryLevel": "off",
  "workbench.enableExperiments": false,
  "extensions.autoUpdate": false,
  "git.autofetch": false,

  // ===========================
  // Exclusivo do perfil Java
  // ===========================
  // JDK
  "java.jdt.ls.java.home": "C:\\d\\java\\jdk21.0.12_12",
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-21",
      "path": "C:\\d\\java\\jdk21.0.12_12",
      "default": true
    }
  ],
  // Economia de recursos no Language Server
  // Sobe só o servidor completo (o padrão "Hybrid" sobe também um servidor leve extra)
  "java.server.launchMode": "Standard",
  // JVM do Language Server: GC mais econômico e limite de 1 GB de memória
  "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx1G -Xms100m -Xlog:disable",
  // Não procura nem importa projetos Gradle (usamos só Maven)
  "java.import.gradle.enabled": false,
  // Compila um projeto por vez, evitando picos de CPU e memória
  "java.maxConcurrentBuilds": 1,
  // Reimporta o projeto sozinho quando o pom.xml muda, sem perguntar
  "java.configuration.updateBuildConfiguration": "automatic",
  // Não exibe o nome dos parâmetros nas chamadas de método
  "java.inlayHints.parameterNames.enabled": "none",
  // Desliga a análise de nulos (@Nullable/@NonNull) e a pergunta sobre ela
  "java.compile.nullAnalysis.mode": "disabled",
  // Não envia dados de uso para a Red Hat
  "redhat.telemetry.enabled": false,
  // Arquivos ignorados por watcher/busca
  "files.watcherExclude": {
    "**/target/**": true,
    "**/.git/objects/**": true
  },
  "search.exclude": {
    "**/target": true
  },
  // Terminal: JAVA_HOME e PATH para o mvnw
  "terminal.integrated.env.windows": {
    "JAVA_HOME": "C:\\d\\java\\jdk21.0.12_12",
    "PATH": "C:\\d\\java\\jdk21.0.12_12\\bin;${env:PATH}"
  }
}
